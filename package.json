{
  "name": "gem-price-comparison",
  "version": "1.0.0",
  "description": "GeM products ke demo prices ko doosre marketplaces se compare karne wala desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.samarth.gempricecomparison",
    "productName": "Marketplace Price Comparison",
    "mac": {
      "target": ["dmg"]
    }
  }
}